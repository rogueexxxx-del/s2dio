# ==============================================================================
# S2DIO Environment Variables (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Publishable Key (safe for client bundles)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (NEVER expose to client; used in webhooks & admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. VST3 Local Bridge Configuration
# ------------------------------------------------------------------------------
# Local loopback port for the S2DIO VST3 DAW Plugin
NEXT_PUBLIC_VST3_BRIDGE_URL=ws://127.0.0.1:4949

# ------------------------------------------------------------------------------
# 3. Stripe (Payments & Subscriptions) - Test Mode First
# ------------------------------------------------------------------------------
# Stripe Secret API Key (sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Signing Secret (whsec_...) from Stripe Dashboard -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs for Subscription Tiers
STRIPE_PRICE_STARTER=price_starter_test_id
STRIPE_PRICE_PRO_FLEX=price_pro_flex_test_id
STRIPE_PRICE_PRO_UNLIMITED=price_pro_unlimited_test_id

# Public URL of the app for Stripe redirect callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. WebRTC / SFU Relay (LiveKit or Cloudflare Calls)
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-livekit-domain.livekit.cloud
